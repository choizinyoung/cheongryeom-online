# Railway Postgres 를 연결하면 자동으로 들어옴: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:pass@localhost:5432/cheongryeom
# 외부(public) URL 로 접속할 때만 true
DATABASE_SSL=false

# 토큰 서명 키 (긴 랜덤 문자열). production 에서는 필수
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=production

# 프론트 주소 (쉼표로 여러 개 가능). 미설정 시 모든 출처 허용
CORS_ORIGIN=https://your-web.up.railway.app

# 관리자 계정 1개 (서버 시작 시 생성/비밀번호 갱신)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
